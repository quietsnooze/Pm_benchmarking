{
  "hooks": {
    "PreToolUse": [
      {
        "matcher": "Bash",
        "hooks": [
          {
            "type": "command",
            "command": "bash .claude/hooks/check-credentials.sh",
            "timeout": 15,
            "statusMessage": "Scanning staged diff for credentials..."
          }
        ]
      }
    ],
    "PostToolUse": [
      {
        "matcher": "Edit|MultiEdit|Write",
        "hooks": [
          {
            "type": "command",
            "command": "bash .claude/hooks/ruff-format.sh",
            "timeout": 30,
            "statusMessage": "Running ruff format + lint-fix..."
          }
        ]
      }
    ]
  }
}
